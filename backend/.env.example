# Backend environment variables
# Copy this file to .env and adjust values

# ── Server ────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
# The origin of your Next.js frontend during local development.
FRONTEND_URL=http://localhost:3000

# ── Prompt validation ─────────────────────────────────────────────────────────
# Maximum accepted prompt length in characters.
MAX_PROMPT_LENGTH=100000

# ── Tokenizer ─────────────────────────────────────────────────────────────────
# Key into the tokenizer registry (see analysis/tokenizer.py).
DEFAULT_TOKENIZER=tiktoken

# ── Module 4: Prompt optimization generation ─────────────────────────────────
# Pass the model identifier in each /api/optimize request. LiteLLM reads the
# selected provider's credential from its standard environment variable.
OPTIMIZATION_TEMPERATURE=0.2
OPTIMIZATION_MAX_OUTPUT_TOKENS=2048
OPTIMIZATION_TIMEOUT_SECONDS=60
