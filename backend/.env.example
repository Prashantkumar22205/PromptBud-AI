# Backend environment variables
# Copy this file to .env and adjust values

# ── Server ────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
# The origin of your Next.js frontend during local development.
FRONTEND_URL=http://localhost:3000

# ── Prompt validation ─────────────────────────────────────────────────────────
# Maximum accepted prompt length in characters.
MAX_PROMPT_LENGTH=100000

# ── Tokenizer ─────────────────────────────────────────────────────────────────
# Key into the tokenizer registry (see analysis/tokenizer.py).
DEFAULT_TOKENIZER=tiktoken

# ── Module 4: Prompt optimization generation ─────────────────────────────────
# Pass the model identifier in each /api/optimize request. LiteLLM reads the
# selected provider's credential from its standard environment variable.
OPTIMIZATION_TEMPERATURE=0.2
OPTIMIZATION_MAX_OUTPUT_TOKENS=2048
OPTIMIZATION_TIMEOUT_SECONDS=60

# ── Module 5: Prompt evaluation ──────────────────────────────────────────────
EVALUATION_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Module 5B: Downstream response evaluation ────────────────────────────────
# Must be configured independently; never defaults to the target/optimizer model.
RESPONSE_EVALUATOR_MODEL=
RESPONSE_EVALUATOR_TEMPERATURE=0.0
RESPONSE_EVALUATOR_MAX_OUTPUT_TOKENS=1200
RESPONSE_EVALUATOR_TIMEOUT_SECONDS=90
# Optional JSON map keyed by exact target model ID; values are USD per 1M tokens.
# Example shape: {"provider/model":{"input_price_per_million":1.0,"output_price_per_million":2.0}}
TARGET_MODEL_PRICING_JSON=


GEMINI_API_KEY=your_gemini_api_key_here